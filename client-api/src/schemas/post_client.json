{
  "title": "PostClient",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "document_number": {
      "type": "string",
      "pattern": "^[A-Z0-9]{12}[0-9]{2}$"
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,50}$"
    }
  },
  "required": [
    "name",
    "document_number",
    "operation"
  ],
  "additionalProperties": false
}
