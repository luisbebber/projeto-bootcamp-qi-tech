{
  "title": "PostWithdrawal",
  "type": "object",
  "properties": {
    "amount": {
      "type": "string",
      "pattern": "^0*[0-9]{1,13}(\\.[0-9]{1,2})?$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "receiver_data": {
      "type": "object",
      "properties": {
        "ispb": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "account_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6
        },
        "account_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "account_digit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "account_type": {
          "type": "string",
          "enum": [
            "checking",
            "savings",
            "salary",
            "payment"
          ]
        },
        "owner_document_number": {
          "type": "string",
          "pattern": "^([0-9]{11}|[0-9]{14})$"
        },
        "owner_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        }
      },
      "required": [
        "ispb",
        "account_branch",
        "account_number",
        "account_digit",
        "account_type",
        "owner_document_number",
        "owner_name"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "amount",
    "idempotency_key",
    "receiver_data"
  ],
  "additionalProperties": false
}
